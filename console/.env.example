# ── REA Console configuration ───────────────────────────────────────────────
# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.

# Where the console listens. Loopback by default: this is a local tool and the
# bind address is the single biggest control on its exposure. Only widen it if
# you understand the consequences (and then REA_CONSOLE_TOKEN becomes mandatory).
REA_CONSOLE_PORT=7749
REA_CONSOLE_BIND=127.0.0.1

# Optional shared secret. If set, every request must present it as
# `Authorization: Bearer <token>` (the UI stores it per-browser). REQUIRED and
# enforced automatically whenever REA_CONSOLE_BIND is not a loopback address.
REA_CONSOLE_TOKEN=

# ── Agent mode (natural-language targets + research teardowns) ───────────────
# Leave ANTHROPIC_API_KEY empty to run Direct mode only (links/paths → real REA
# evidence, no LLM reasoning). Drop a key in and Agent mode activates on restart.
ANTHROPIC_API_KEY=
# Default is the current Opus. Switch to claude-sonnet-5-5 or claude-haiku-5-5
# to trade some depth for lower cost.
REA_CONSOLE_MODEL=claude-opus-5-5

# ── Engine wiring ────────────────────────────────────────────────────────────
# Path to the REA CLI entry. Defaults to ../scripts/rea.mjs relative to this app
# (i.e. the REA repo this console lives inside). Override to point elsewhere.
REA_BIN=
# Chrome-family browser used for website analysis (CDP). Auto-detected if empty.
REA_CONSOLE_CHROME=

# ── Hardening knobs (sane defaults — change only with reason) ────────────────
# Trust X-Forwarded-For for client IP. OFF by default so a spoofed header can
# never forge a trusted address or ban a third party. Turn on ONLY behind a
# proxy you control that strips inbound XFF.
REA_CONSOLE_TRUST_PROXY=false
# Per-IP request budget per rolling minute before throttling kicks in.
REA_CONSOLE_RATE_PER_MIN=120
# Hard ceiling on how long any single REA command may run (ms).
REA_CONSOLE_CMD_TIMEOUT_MS=180000
