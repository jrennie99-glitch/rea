# ── REA Console configuration ───────────────────────────────────────────────
# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.

# Where the console listens. Loopback by default: this is a local tool and the
# bind address is the single biggest control on its exposure. Only widen it if
# you understand the consequences (and then REA_CONSOLE_TOKEN becomes mandatory).
REA_CONSOLE_PORT=7749
REA_CONSOLE_BIND=127.0.0.1

# Optional shared secret. If set, every request must present it as
# `Authorization: Bearer <token>` (the UI stores it per-browser). REQUIRED and
# enforced automatically whenever REA_CONSOLE_BIND is not a loopback address.
REA_CONSOLE_TOKEN=

# ── Agent mode (natural-language targets + research teardowns) ───────────────
# Open-source first. With nothing set below, the agent uses your LOCAL Ollama
# (http://127.0.0.1:11434/v1) with model qwen2.5:3b — no key, no cost.
#
# IMPORTANT: Agent mode drives REA by calling tools, so the model MUST support
# tool/function calling. qwen2.5 does; many "uncensored" chat fine-tunes
# (e.g. ornith-uncensored) do NOT and will just talk instead of analysing.
#
# Point at any OpenAI-compatible server (Ollama, LM Studio, llama.cpp, vLLM) or
# a hosted gateway (OpenRouter, Together, Groq):
REA_CONSOLE_LLM_BASE_URL=
REA_CONSOLE_LLM_MODEL=
REA_CONSOLE_LLM_KEY=
# Optional two-model pipeline (local backend): the model above drives the tools
# to gather evidence, then this WRITER model synthesises the final teardown —
# pair a tool-capable driver (qwen2.5) with a stronger writer (ornith). Defaults
# to ornith-uncensored:latest on the local setup; set empty to use one model.
REA_CONSOLE_LLM_WRITER=ornith-uncensored:latest
# Examples:
#   REA_CONSOLE_LLM_MODEL=qwen2.5:7b            # bigger local, better reasoning
#   REA_CONSOLE_LLM_BASE_URL=http://127.0.0.1:1234/v1   # LM Studio
#   REA_CONSOLE_LLM_BASE_URL=https://openrouter.ai/api/v1
#   REA_CONSOLE_LLM_KEY=sk-or-...               # a real key for hosted gateways

# Optional: use Anthropic's Claude instead (overrides the local default only if
# no REA_CONSOLE_LLM_BASE_URL is set).
ANTHROPIC_API_KEY=
REA_CONSOLE_MODEL=claude-opus-5-5

# ── Engine wiring ────────────────────────────────────────────────────────────
# Path to the REA CLI entry. Defaults to ../scripts/rea.mjs relative to this app
# (i.e. the REA repo this console lives inside). Override to point elsewhere.
REA_BIN=
# Chrome-family browser used for website analysis (CDP). Auto-detected if empty.
REA_CONSOLE_CHROME=

# ── Hardening knobs (sane defaults — change only with reason) ────────────────
# Trust X-Forwarded-For for client IP. OFF by default so a spoofed header can
# never forge a trusted address or ban a third party. Turn on ONLY behind a
# proxy you control that strips inbound XFF.
REA_CONSOLE_TRUST_PROXY=false
# Per-IP request budget per rolling minute before throttling kicks in.
REA_CONSOLE_RATE_PER_MIN=120
# Hard ceiling on how long any single REA command may run (ms).
REA_CONSOLE_CMD_TIMEOUT_MS=180000
